# 复制此文件为 .env.local，填入真实值（.env.local 已在 .gitignore 中排除）
# Vercel 部署时在 Dashboard → Settings → Environment Variables 中添加

# Supabase 项目 URL（在 Supabase → Project Settings → API 中找到）
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase anon/public key（在同一页面 anon public 一栏）
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
